+        }
+        return result;
+    }
+    // ---- EXPERIMENT: dedicated reader thread ----
+    // DuckDB's scan threads call this under the scan lock; they only take queued batches.
+    static int QueuedGetNext(ArrowArrayStream *stream, ArrowArray *out) {
+        auto &self = Lookup(stream);
+        auto waited = WallNow();
+        std::unique_lock<std::mutex> lock(self.queue_mutex);
+        if (!self.reader.joinable() && !self.reader_done) {
+            // Start lazily, after DuckDB has finished its own setup calls on this stream.
+            self.reader = std::thread([&self]() { self.ReadAll(); });
+        }
+        self.queue_cv.wait(lock, [&]() { return !self.queue.empty() || self.reader_done; });
+        self.queue_wait_seconds += WallNow() - waited;
+        if (!self.queue.empty()) {
+            *out = self.queue.front();
+            self.queue.pop_front();
+            lock.unlock();
+            self.queue_cv.notify_all();
+            return 0;
+        }
+        if (self.reader_error != 0) {
+            return self.reader_error;
+        }
+        std::memset(out, 0, sizeof(*out)); // end of stream: release == nullptr
+        return 0;
+    }
+    static const char *QueuedGetLastError(ArrowArrayStream *stream) {
+        auto &self = Lookup(stream);
+        std::lock_guard<std::mutex> lock(self.queue_mutex);
+        return self.reader_error_message.empty() ? nullptr : self.reader_error_message.c_str();
+    }
+    void ReadAll() {
+        while (true) {
+            ArrowArray batch;
+            std::memset(&batch, 0, sizeof(batch));
+            auto result = CallConnector(&batch);
+            string message;
+            if (result != 0 && original_get_last_error) {
+                auto error = original_get_last_error(&arrow_array_stream); // read on the failing thread
+                message = error ? error : "Arrow stream failed without an error message";
+            }
+            std::unique_lock<std::mutex> lock(queue_mutex);
+            if (result != 0 || !batch.release) {
+                reader_error = result;
+                reader_error_message = message;
+                reader_done = true;
+                lock.unlock();
+                queue_cv.notify_all();
+                return;
+            }
+            queue_cv.wait(lock, [&]() { return reader_stop || queue.size() < READER_QUEUE_BATCHES; });
+            if (reader_stop) {
+                lock.unlock();
+                batch.release(&batch);
+                return;
+            }
+            queue.push_back(batch);
+            peak_queued = MaxValue<idx_t>(peak_queued, queue.size());
+            lock.unlock();
+            queue_cv.notify_all();
+        }
+    }
+    void StopReader() {
+        {
+            std::lock_guard<std::mutex> lock(queue_mutex);
+            reader_stop = true;
+        }
+        queue_cv.notify_all();
+        if (reader.joinable()) {
+            reader.join();
+        }
+        for (auto &batch : queue) {
+            if (batch.release) {
+                batch.release(&batch);
+            }
+        }
+        queue.clear();
+        std::lock_guard<std::mutex> registry_lock(RegistryMutex());
+        Registry().erase(&arrow_array_stream);
+    }
+    const char *(*original_get_last_error)(ArrowArrayStream *) = nullptr;
+    std::mutex queue_mutex;
+    std::condition_variable queue_cv;
+    std::deque<ArrowArray> queue;
+    std::thread reader;
+    bool reader_stop = false;
+    bool reader_done = false;
+    int reader_error = 0;
+    string reader_error_message;
+    idx_t peak_queued = 0;
+    double queue_wait_seconds = 0;
+    // ---- end EXPERIMENT ----
+
+    void ReportTiming() {
+        if (!ScanTimingEnabled() || original_get_next == nullptr) {
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(RegistryMutex());
+            Registry().erase(&arrow_array_stream);
+        }
+        auto &scan = ScanSide();
+        std::lock_guard<std::mutex> scan_lock(scan.mutex);
+        std::lock_guard<std::mutex> lock(timing_mutex);
+        auto span = last_get_next - first_get_next;
+        std::fprintf(stderr,
+                     "ADBC_SCAN_TIMING rows=%llu batches=%llu\n"
+                     "  execute_query_s=%.3f  execute_to_first_get_next_s=%.3f  stream_span_s=%.3f\n"
+                     "  inside_get_next_s=%.3f (cpu %.3f, waiting %.3f)  gaps_no_get_next_s=%.3f  get_next_threads=%zu\n"
+                     "  scan_fetch_calls=%llu scan_fetch_s=%.3f  lock_wait_s=%.3f\n"
+                     "  convert_calls=%llu convert_s=%.3f (cpu %.3f)  convert_threads=%zu\n"
+                     "  reader_thread=%s  duckdb_queue_wait_s=%.3f (summed over scan threads)  peak_queued=%llu\n",
+                     (unsigned long long)rows, (unsigned long long)get_next_calls, execute_returned - execute_started,
+                     first_get_next - execute_returned, span, get_next_seconds, get_next_cpu_seconds,
+                     get_next_seconds - get_next_cpu_seconds, span - get_next_seconds, get_next_threads.size(),
+                     (unsigned long long)scan.fetch_calls, scan.fetch_call_seconds,
+                     scan.fetch_call_seconds - get_next_seconds, (unsigned long long)scan.convert_calls,
+                     scan.convert_seconds, scan.convert_cpu_seconds, scan.convert_threads.size(),
+                     ReaderThreadEnabled() ? "on" : "off", queue_wait_seconds, (unsigned long long)peak_queued);
+    }
+    int (*original_get_next)(ArrowArrayStream *, ArrowArray *) = nullptr;
+    std::mutex timing_mutex;
+    double execute_started = 0, execute_returned = 0;
+    double first_get_next = -1, last_get_next = 0;
+    double get_next_seconds = 0, get_next_cpu_seconds = 0;
+    idx_t get_next_calls = 0, rows = 0;
+    std::unordered_set<std::thread::id> get_next_threads;
+    // ---- end TEMPORARY ----

+    static int TimedGetNext(ArrowArrayStream *stream, ArrowArray *out) {
+        return Lookup(stream).CallConnector(out);
+    }
+    // One connector get_next call, timed when ADBC_SCAN_TIMING is set.
+    int CallConnector(ArrowArray *out) {
+        auto stream = &arrow_array_stream;
+        auto self = this;
+        if (!ScanTimingEnabled()) {
+            return original_get_next(stream, out);
+        }
+        auto started = WallNow();
+        auto cpu_started = ThreadCpuNow();
+        auto result = self->original_get_next(stream, out);
+        auto cpu = ThreadCpuNow() - cpu_started;
+        auto ended = WallNow();
+        std::lock_guard<std::mutex> lock(self->timing_mutex);
+        self->get_next_calls++;
+        self->get_next_seconds += ended - started;
+        self->get_next_cpu_seconds += cpu;
+        if (self->first_get_next < 0) {

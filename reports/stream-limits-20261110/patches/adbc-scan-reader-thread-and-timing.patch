+// ---- TEMPORARY scan timing, enabled by ADBC_SCAN_TIMING (not for commit) ----
+bool ScanTimingEnabled() {
+    static bool enabled = std::getenv("ADBC_SCAN_TIMING") != nullptr;
+    return enabled;
+}
+double WallNow() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+double ThreadCpuNow() {
+    timespec ts;
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+    return double(ts.tv_sec) + double(ts.tv_nsec) * 1e-9;
+}
+// Scan-side timers. The measurement runs one read_adbc query per process, so process-wide totals suffice.
+struct ScanSideTiming {
+    std::mutex mutex;
+    double fetch_call_seconds = 0; // ArrowScanParallelStateNext, including waits for the scan lock
+    idx_t fetch_calls = 0;
+    double convert_seconds = 0;
+    double convert_cpu_seconds = 0;
+    idx_t convert_calls = 0;
+    std::unordered_set<std::thread::id> convert_threads;
+};
+ScanSideTiming &ScanSide() {
+    static ScanSideTiming timing;
+    return timing;
+}
+// ---- end TEMPORARY ----
+
+// EXPERIMENT: one dedicated thread makes every connector get_next call (ADBC_READER_THREAD=1).
+bool ReaderThreadEnabled() {
+    static bool enabled = std::getenv("ADBC_READER_THREAD") != nullptr;
+    return enabled;
+}
+constexpr idx_t READER_QUEUE_BATCHES = 16;

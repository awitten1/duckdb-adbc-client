+    // ---- TEMPORARY scan timing ----
+    static std::mutex &RegistryMutex() {
+        static std::mutex mutex;
+        return mutex;
+    }
+    static std::unordered_map<ArrowArrayStream *, AdbcExecutionStream *> &Registry() {
+        static std::unordered_map<ArrowArrayStream *, AdbcExecutionStream *> registry;
+        return registry;
+    }
+    static AdbcExecutionStream &Lookup(ArrowArrayStream *stream) {
+        std::lock_guard<std::mutex> lock(RegistryMutex());

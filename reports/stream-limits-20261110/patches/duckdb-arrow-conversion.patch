+//! Arrow's decimal precision bounds every value to DuckDB's physical width for that precision, so narrowing keeps
+//! the low-order bits (previously a TryCast whose failure was only asserted).
+template <class TGT>
+static inline TGT DecimalToPhysical(int32_t value) {
+	return static_cast<TGT>(value);
+}
+template <class TGT>
+static inline TGT DecimalToPhysical(int64_t value) {
+	return static_cast<TGT>(value);
+}
+template <class TGT>
+static inline TGT DecimalToPhysical(hugeint_t value) {
+	return static_cast<TGT>(static_cast<int64_t>(value.lower));
+}

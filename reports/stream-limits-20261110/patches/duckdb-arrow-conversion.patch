+static void NarrowDecimal(const SRC *src_ptr, TGT *tgt_ptr, idx_t size) {
+	for (idx_t row = 0; row < size; row++) {
+		tgt_ptr[row] = DecimalToPhysical<TGT>(src_ptr[row]);
+	}
+}

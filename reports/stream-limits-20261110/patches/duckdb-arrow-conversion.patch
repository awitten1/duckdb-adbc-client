+#if !defined(DUCKDB_DEBUG_NO_INLINE) && !DUCKDB_IS_BIG_ENDIAN
+//! Writes a string_t that references (or inlines) Arrow string data directly into its destination with two
+//! 8-byte stores. The string_t constructor assembles the value in a temporary that is then copied out with one
+//! 16-byte load; on x86 that load cannot be forwarded from the preceding narrower stores and stalls on every row.
+//! Inline strings are read with fixed-width loads when those stay before `limit`, the end of the string data.
+static inline void WriteArrowString(string_t &target, const char *cptr, uint32_t len, const char *limit) {
+	uint64_t head; // length, then the prefix or the first four inlined bytes
+	uint64_t tail; // pointer, or inlined bytes 4-11
+	if (len > string_t::INLINE_LENGTH) {
+		uint32_t prefix;
+		memcpy(&prefix, cptr, sizeof(prefix));
+		head = uint64_t(len) | (uint64_t(prefix) << 32);
+		tail = uint64_t(reinterpret_cast<uintptr_t>(cptr));
+	} else if (limit - cptr >= static_cast<int64_t>(string_t::INLINE_LENGTH)) {
+		uint32_t first;
+		uint64_t rest;
+		memcpy(&first, cptr, sizeof(first));
+		memcpy(&rest, cptr + sizeof(first), sizeof(rest));
+		// Inlined strings are zero padded: clear the bytes after the string.
+		auto first_bytes = MinValue<uint32_t>(len, 4);
+		auto rest_bytes = len > 4 ? len - 4 : 0;
+		uint32_t first_mask = first_bytes == 4 ? ~uint32_t(0) : (uint32_t(1) << (8 * first_bytes)) - 1;
+		uint64_t rest_mask = rest_bytes == 8 ? ~uint64_t(0) : (uint64_t(1) << (8 * rest_bytes)) - 1;
+		head = uint64_t(len) | (uint64_t(first & first_mask) << 32);
+		tail = rest & rest_mask;
+	} else {
+		// Too close to the end of the string data for fixed-width loads.
+		target = string_t(cptr, len);
+		return;
+	}
+	auto destination = reinterpret_cast<data_ptr_t>(&target);
+	memcpy(destination, &head, sizeof(head));
+	memcpy(destination + sizeof(head), &tail, sizeof(tail));
+}
+#endif

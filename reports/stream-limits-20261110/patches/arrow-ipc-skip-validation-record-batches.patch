Subject: [PATCH] StreamDecoder: pass skip_validation to RecordBatchDecoder

---
 src/reader/stream.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/reader/stream.rs b/src/reader/stream.rs
index bfecf7b..de32eb4 100644
--- a/src/reader/stream.rs
+++ b/src/reader/stream.rs
@@ -247,6 +247,8 @@ impl StreamDecoder {
                                 &version,
                             )?
                             .with_require_alignment(self.require_alignment)
+                            // Honor with_skip_validation for record batches, as the dictionary path does.
+                            .with_skip_validation(self.skip_validation.clone())
                             .read_record_batch()?;
                             self.state = DecoderState::default();
                             return Ok(Some(batch));

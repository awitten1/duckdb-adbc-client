# name: test/sql/sqlite/partial_sort.test
# description: Partial sorting through a non-ClickHouse ADBC driver
# group: [sqlite]

require adbc

require-env ADBC_DRIVER_PATH

# Use an isolated, file-backed database shared by the independent connections.
statement ok
COPY (SELECT unnest(['profile_version = 1', 'driver = "sqlite"', '[Options]', 'uri = ''{TEST_DIR}/partial_sort.sqlite'''])) TO '{TEST_DIR}/partial_sort.toml' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '')

statement ok
CALL adbc_execute('profile://{TEST_DIR}/partial_sort.toml', 'CREATE TABLE events (id INTEGER, score INTEGER, payload TEXT)')

# No index or physical-order declaration. Keep duplicate and NULL keys.
statement ok
CALL adbc_execute('profile://{TEST_DIR}/partial_sort.toml', 'INSERT INTO events VALUES (100,2,''upper''), (0,3,''lower''), (50,1,''middle''), (NULL,4,''null''), (50,1,''middle'')')

query IIT
SELECT * FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 0.5)
----
NULL	4	null
0	3	lower
100	2	upper
50	1	middle
50	1	middle

# An empty namespace emits an unqualified table name. All rows sorted locally.
query IIT
SELECT * FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', '', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 0)
----
NULL	4	null
0	3	lower
100	2	upper
50	1	middle
50	1	middle

# All rows sorted remotely, with explicit NULL placement and a different order.
query IIT
SELECT * FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', '', 'events', partition_key := 'id', sort_columns := ['id', 'score'], descending := [false, true], nulls_first := [true, false], pushdown_ratio := 1)
----
NULL	4	null
0	3	lower
50	1	middle
50	1	middle
100	2	upper

# The partition column can differ from both physical order and output order.
query IIT
SELECT * FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'score', sort_columns := ['id', 'score'], nulls_first := [true, false], pushdown_ratio := 0.5)
----
NULL	4	null
0	3	lower
50	1	middle
50	1	middle
100	2	upper

# Standard SQL identifier quoting preserves double quotes and backslashes.
statement ok
CALL adbc_execute('profile://{TEST_DIR}/partial_sort.toml', 'CREATE TABLE "table ""quoted""\path" ("key ""quoted""\path" INTEGER, score INTEGER)')

statement ok
CALL adbc_execute('profile://{TEST_DIR}/partial_sort.toml', 'INSERT INTO "table ""quoted""\path" VALUES (100,1),(0,3),(50,2)')

query II
SELECT * FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'table "quoted"\path', partition_key := 'key "quoted"\path', sort_columns := ['score'], pushdown_ratio := 0.5)
----
100	1
50	2
0	3

# Empty sources and all-NULL partition columns also work without metadata queries.
statement ok
CALL adbc_execute('profile://{TEST_DIR}/partial_sort.toml', 'CREATE TABLE empty (id INTEGER, score INTEGER)')

query I
SELECT count(*) FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'empty', partition_key := 'id', sort_columns := ['score'], pushdown_ratio := 0.5)
----
0

statement ok
CALL adbc_execute('profile://{TEST_DIR}/partial_sort.toml', 'CREATE TABLE null_keys (id INTEGER, score INTEGER)')

statement ok
CALL adbc_execute('profile://{TEST_DIR}/partial_sort.toml', 'INSERT INTO null_keys VALUES (NULL,3),(NULL,1),(NULL,2)')

query II
SELECT * FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'null_keys', partition_key := 'id', sort_columns := ['score'], pushdown_ratio := 0.5)
----
NULL	1
NULL	2
NULL	3

# Projection retains hidden sort keys while pruning the returned payload layout.

query T
SELECT payload FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 0)
----
null
lower
upper
middle
middle

query T
SELECT payload FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 0.5)
----
null
lower
upper
middle
middle

query T
SELECT payload FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 1)
----
null
lower
upper
middle
middle

# Reordered/duplicate columns and a filter-only column.
query TIT
SELECT payload, id, payload AS again FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 0.5) WHERE score < 4
----
lower	0	lower
upper	100	upper
middle	50	middle
middle	50	middle

# Count and constant projections must preserve duplicates and cardinality.
query I
SELECT count(*) FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 0.5)
----
5

query I
SELECT 42 FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 1) LIMIT 2
----
42
42

statement ok
PREPARE projected AS SELECT payload FROM read_adbc_partial_sort('profile://{TEST_DIR}/partial_sort.toml', 'main', 'events', partition_key := 'id', sort_columns := ['score', 'id'], descending := [true, false], pushdown_ratio := 0.5)

query T
EXECUTE projected
----
null
lower
upper
middle
middle

query T
EXECUTE projected
----
null
lower
upper
middle
middle
